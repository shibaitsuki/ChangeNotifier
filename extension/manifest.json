{
  "manifest_version": 3,
  "name": "ChangeNotifier Picker",
  "version": "0.1.0",
  "description": "ページ上の要素をクリックして選び、ChangeNotifierサーバに監視登録する",
  "permissions": ["scripting", "activeTab", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "http://192.168.10.19/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChangeNotifier",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
